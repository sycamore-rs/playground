[package]
name = "sycamore-playground"
version = "0.1.0"
edition = "2024"

[dependencies]
js-sys = "0.3.107"
sycamore = "0.10.0-beta.1"
sycamore-router = "0.10.0-beta.1"
# Keep the CLI in Dockerfile and flake.nix in sync with this exact version.
wasm-bindgen = "=0.2.126"
web-sys = "0.3.107"

# Keep submitted code quick to rebuild, without shipping development debug info.
[profile.dev]
debug = 0

# Dependencies are warmed by precompilation and reused across submissions.
# Optimize those for small WASM without enabling expensive whole-program LTO.
[profile.dev.package."*"]
opt-level = "s"
